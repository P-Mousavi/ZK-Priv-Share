pragma solidity ^0.8.20;

import "./Verifier.sol"; // Auto-generated by SnarkJS for identity circuit
import "./IdentityTree.sol";

contract ZKIdentity is Groth16Verifier {
    uint256 public constant REGISTRATION_DEPOSIT = 1 ether;

    IdentityTree public identityTree;

    constructor() {
        identityTree = new IdentityTree();
    }

    // Mapping of Commitment -> Deposit Amount
    mapping(uint256 => uint256) public deposits;

    event IdentityRegistered(uint256 indexed commitment, uint256 leafIndex);
    event DepositSlashed(uint256 indexed commitment);

    // ZK Verifier Logic for slashing
    // Note: Parent Verifier expects 11 signals
    function verifyProof(
        uint[2] calldata _pA,
        uint[2][2] calldata _pB,
        uint[2] calldata _pC,
        uint[11] calldata _pubSignals
    ) public view override returns (bool) {
        return super.verifyProof(_pA, _pB, _pC, _pubSignals);
    }

    /**
     * @dev User generates commitment off-chain: Poseidon(secret, nullifier)
     * @param _identityCommitment The Poseidon hash commitment
     */
    function registerIdentity(uint256 _identityCommitment) external payable {
        require(msg.value == REGISTRATION_DEPOSIT, "Incorrect deposit");
        require(deposits[_identityCommitment] == 0, "Already registered");

        deposits[_identityCommitment] = msg.value;
        
        // Insert into Merkle Tree (using Poseidon via IdentityTree)
        identityTree.insert(_identityCommitment);
        
        emit IdentityRegistered(_identityCommitment, identityTree.getNumberOfLeaves() - 1);
    }


    /**
     * @dev Only the Data Contract can slash.
     * With ZK, we slash the "Commitment" effectively burning the deposit.
     * The user can no longer generate valid proofs if we blacklist the root, 
     * but simpler is to lock the funds.
     */
    function slashDeposit(uint256 _commitment) external {
        // Access control check required (onlyDataContract)
        require(deposits[_commitment] > 0, "No deposit to slash");
        deposits[_commitment] = 0; 
        // Logic to send funds to complainant would go here
        emit DepositSlashed(_commitment);
    }

    /**
     * @dev Called by ZKDataContract when a delegate is found guilty.
     * Zeros out the reward assigned to the payoutCommitment and removes the identity from the merkle tree.
     * @param _defendant The address of the guilty delegate (for tracking purposes, actual identity is commitment-based)
     * @param _payoutCommitment The commitment to zero out the reward for
     * @param _identityCommitment The identity commitment to remove from the merkle tree
     */
    function slashAndReward(
        address _defendant,
        uint256 _payoutCommitment,
        uint256 _identityCommitment
    ) external {
        // Access control: only callable by ZKDataContract (would need to add proper access control)
        
        // Zero out the reward assigned to the payoutCommitment
        // This requires access to the rewardTreeBalances mapping from ZKDataContract
        // For now, we'll emit an event and the ZKDataContract will handle the actual zeroing
        emit DepositSlashed(_payoutCommitment);
        
        // Remove the identity from the merkle tree by zeroing the deposit
        // This effectively prevents the delegate from generating valid proofs
        if (deposits[_identityCommitment] > 0) {
            deposits[_identityCommitment] = 0;
            emit DepositSlashed(_identityCommitment);
        }
    }

    /**
     * @dev Called by ZKDataContract when a delegate is found innocent (false accusation).
     * Rewards the defendant for the false accusation.
     * @param _defendant The address of the innocent delegate
     * @param _complainant The address of the false accuser
     */
    function rewardDefendant(
        address _defendant,
        address _complainant
    ) external {
        // Access control: only callable by ZKDataContract (would need to add proper access control)
        
        // The actual reward logic would be handled by ZKDataContract
        // This function is a placeholder for the interface requirement
        // In a full implementation, this might involve transferring funds from the complainant's deposit
    }

    // Test helper flag
    bool public testingMode;

    /**
     * @dev Test helper to enable testing mode
     */
    function setTestingMode(bool _enabled) external {
        testingMode = _enabled;
    }

    /**
     * @dev Test helper to set a Merkle root directly (for benchmarking with circomlib Poseidon)
     * Only callable in testing mode
     */
    function setRoot(uint256 /* _root */) external view {
        require(testingMode, "Not in testing mode");
        // This is a no-op since we now use IdentityTree
        // Kept for backward compatibility with tests
    }
}